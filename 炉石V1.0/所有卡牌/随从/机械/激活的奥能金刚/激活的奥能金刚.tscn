[gd_scene load_steps=2 format=3 uid="uid://0nvyjpr8jgaa"]

[sub_resource type="GDScript" id="GDScript_arcanotron"]
script/source = "extends BaseMinion

func 信号绑定():
	if !player.使用卡牌信号.is_connected(_on_施放酒馆法术):
		player.使用卡牌信号.connect(_on_施放酒馆法术)

func _on_施放酒馆法术(法术:CardEntity):
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	if 法术 is not TavernSpell:
		return
	
	# 使一个友方机械获得+3/+2（金色版本+6/+4）
	var 友方机械 = player.获取战场上的牌().filter(func(item): 
		return item is BaseMinion and Enums.CardRace.机械 in item.race
	)
	
	if !友方机械.is_empty():
		var 目标机械 = 友方机械.pick_random() as BaseMinion
		var 加成值 = Vector2i(3, 2) * 获取倍率()
		var 加成 = AttributeBonus.build(名称, 加成值, 名称)
		目标机械.属性加成(加成, !player.是否在战斗中())
		print(\"激活的奥能金刚：给\", 目标机械.名称, \"加\", 加成值.x, \"/\", 加成值.y)
"

