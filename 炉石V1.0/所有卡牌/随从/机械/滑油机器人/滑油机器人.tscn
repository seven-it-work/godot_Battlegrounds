[sub_resource type="GDScript" id="GDScript_grease"]
script/source = "extends BaseMinion

func 信号绑定():
	if !player.随从失去圣盾信号.is_connected(_on_随从失去圣盾):
		player.随从失去圣盾信号.connect(_on_随从失去圣盾)

func _on_随从失去圣盾(失去圣盾的随从:BaseMinion):
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	# 在一个友方随从失去圣盾后，使其永久获得+2/+1（金色版本+4/+2）
	var 加成值 = Vector2i(2, 1) * 获取倍率()
	var 加成 = AttributeBonus.build(名称, 加成值, 名称)
	失去圣盾的随从.属性加成(加成, true)  # 永久加成
	print(\"滑油机器人：\", 失去圣盾的随从.名称, \"失去圣盾，获得永久+\", 加成值.x, \"/+\", 加成值.y)
"

