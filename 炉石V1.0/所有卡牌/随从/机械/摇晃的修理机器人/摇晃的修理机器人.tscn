[gd_scene load_steps=2 format=3 uid="uid://0nvyjpr8jf86"]

[sub_resource type="GDScript" id="GDScript_repairbot"]
script/source = "extends BaseMinion

func 信号绑定():
	if !player.回合结束信号.is_connected(_on_回合结束):
		player.回合结束信号.connect(_on_回合结束)

func _on_回合结束():
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	# 为本随从磁力吸附一个随机磁力机械（金色版本2个）
	var 倍率 = 获取倍率()
	var 磁力机械列表 = CardUtils.find_card([
		CardUtils.COMMON_CODITION.随从,
		CardUtils.COMMON_CODITION.是否出现在酒馆,
		CardFindCondition.build(\"是否为磁力\",true,Enums.ConditionEnum.等于),
		CardFindCondition.build(\"等级\",player.酒馆等级,Enums.ConditionEnum.小于等于),
		]);
	if 磁力机械列表.is_empty():
		print(\"没有磁力\")
		return
	for i in 倍率:
		var 磁力=CardUtils.get_card(磁力机械列表.pick_random().名称,player)
		添加磁力(磁力,false)
		
"
metadata/_custom_type_script = "uid://d1rstpchmbfdi"

