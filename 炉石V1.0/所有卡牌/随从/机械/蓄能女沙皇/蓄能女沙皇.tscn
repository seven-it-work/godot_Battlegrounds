[gd_scene load_steps=2 format=3 uid="uid://0nvyjpr8jga4"]

[sub_resource type="GDScript" id="GDScript_czarina"]
script/source = "extends BaseMinion

func 信号绑定():
	if !player.使用卡牌信号.is_connected(_on_施放酒馆法术):
		player.使用卡牌信号.connect(_on_施放酒馆法术)

func _on_施放酒馆法术(法术:CardEntity):
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	if 法术 is not TavernSpell:
		return
	
	# 使你具有圣盾的随从获得+3攻击力（金色版本+6攻击力）
	var 加成值 = 3 * 获取倍率()
	var 圣盾随从 = player.获取战场上的牌().filter(func(item): 
		return item is BaseMinion and item.圣盾
	)
	
	for 随从 in 圣盾随从:
		var 加成 = AttributeBonus.build(名称, Vector2i(加成值, 0), 名称)
		随从.属性加成(加成, !player.是否在战斗中())
		print(\"蓄能女沙皇：给圣盾随从\", 随从.名称, \"加\", 加成值, \"攻击力\")
"

[node name="蓄能女沙皇" type="Node"]
