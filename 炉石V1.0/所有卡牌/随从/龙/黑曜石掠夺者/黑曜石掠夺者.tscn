[gd_scene load_steps=2 format=3 uid="uid://bq8x7k9m2n4pi"]

[sub_resource type="GDScript" id="GDScript_1"]
resource_name = "黑曜石掠夺者"
script/source = "extends BaseMinion

# 黑曜石掠夺者：每当本随从攻击时，对目标及一个相邻的随从造成等同于本随从攻击力的伤害
# 需要重写攻击方法

func 攻击其他随从(防御者:BaseMinion):
	# 先执行正常攻击
	await super.攻击其他随从(防御者)
	
	# 攻击后触发溅射伤害
	await 触发溅射伤害(防御者)

func 触发溅射伤害(目标:BaseMinion):
	# 获取目标及相邻随从
	var 目标列表 = [目标]
	
	# 获取目标的相邻随从
	var 战场随从 = player.获取战场上的牌()
	var 目标位置 = -1
	
	# 找到目标的位置
	for i in range(战场随从.size()):
		if 战场随从[i] == 目标:
			目标位置 = i
			break
	
	if 目标位置 != -1:
		# 添加相邻的随从
		for 偏移 in [-1, 1]:
			var 相邻位置 = 目标位置 + 偏移
			if 相邻位置 >= 0 and 相邻位置 < 战场随从.size():
				var 相邻随从 = 战场随从[相邻位置]
				if 相邻随从 is BaseMinion and 相邻随从 != 目标:
					目标列表.append(相邻随从)
					break  # 只添加一个相邻随从
	
	# 对目标列表造成伤害
	var 伤害值 = 获取带加成属性().x
	for 随从 in 目标列表:
		if 随从 is BaseMinion:
			await 造成伤害(随从 as BaseMinion, 伤害值)
	
	print("黑曜石掠夺者：对 ", 目标列表.size(), " 个随从造成 ", 伤害值, " 点溅射伤害")

func 造成伤害(随从:BaseMinion, 伤害:int):
	# 造成伤害的逻辑
	if 随从.获取圣盾():
		# 圣盾抵消伤害
		随从.攻击过了关键词失效.append("圣盾")
		print("黑曜石掠夺者：", 随从.名称, " 的圣盾被破坏")
		return
	
	if 剧毒 or 烈毒:
		# 剧毒/烈毒直接死亡
		await 随从.死亡(self)
		return
	
	# 正常伤害
	随从.current_hp -= 伤害
	print("黑曜石掠夺者：对 ", 随从.名称, " 造成 ", 伤害, " 点伤害")
	
	if 随从.current_hp <= 0:
		await 随从.死亡(self)
"

