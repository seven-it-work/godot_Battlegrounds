[sub_resource type="GDScript" id="GDScript_1"]
resource_name = "奥术守护者卡雷苟斯"
script/source = "extends BaseMinion

func 信号绑定():
	if !player.战吼触发信号.is_connected(_on_战吼触发):
		player.战吼触发信号.connect(_on_战吼触发)

func _on_战吼触发(触发卡牌:CardEntity):
	# 仅当在战场上时生效
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	# 获取所有友方龙
	var 友方龙列表 = player.获取战场上的牌().filter(func(item): 
		return item is BaseMinion and Enums.CardRace.龙 in item.race and item != self
	)
	
	var 加成值 = Vector2i(1, 2) * 获取倍率()  # 普通:+1/+2, 金色:+2/+4
	
	for 龙 in 友方龙列表:
		var 加成 = AttributeBonus.build(名称, 加成值, 名称)
		龙.属性加成(加成, !player.是否在战斗中())
	
	print(\"奥术守护者卡雷苟斯：使 \", 友方龙列表.size(), \" 个友方龙获得 +\", 加成值.x, \"/+\", 加成值.y)
"

