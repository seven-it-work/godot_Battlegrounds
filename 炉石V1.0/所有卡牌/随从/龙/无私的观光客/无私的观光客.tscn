resource_name = "无私的观光客战吼"
script/source = "extends Roar

func _具体战吼方法接口(触发卡:CardEntity):
	# 战吼：你的队伍的铸币上限提高（1）枚
	var 提高数量 = 触发卡.获取倍率()  # 普通:1枚, 金色:2枚
	
	# 提高铸币上限
	触发卡.player.铸币上限 += 提高数量
	
	print(\"无私的观光客：铸币上限提高 \", 提高数量, \" 枚，当前上限: \", 触发卡.player.铸币上限)
"

