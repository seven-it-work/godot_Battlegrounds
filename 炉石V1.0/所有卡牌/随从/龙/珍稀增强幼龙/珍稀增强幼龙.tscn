[gd_scene load_steps=2 format=3 uid="uid://bq8x7k9m2n4pc"]

[sub_resource type="GDScript" id="GDScript_1"]
resource_name = "珍稀增强幼龙"
script/source = "extends BaseMinion

func 信号绑定():
	# 监听战斗开始信号
	if !player.战斗开始信号.is_connected(_on_战斗开始):
		player.战斗开始信号.connect(_on_战斗开始)

func _on_战斗开始():
	# 战斗开始时，使所有龙获得加成
	if 卡片所在位置 != Enums.CardPosition.战场:
		return
	
	# 获取所有友方龙（包括自己）
	var 友方龙列表 = player.获取战场上的牌().filter(func(item): 
		return item is BaseMinion and Enums.CardRace.龙 in item.race
	)
	
	var 加成值 = Vector2i(3, 3) * 获取倍率()  # 普通:+3/+3, 金色:+6/+6
	
	for 龙 in 友方龙列表:
		var 加成 = AttributeBonus.build(名称, 加成值, 名称)
		龙.属性加成(加成, false)  # 战斗中的加成是临时的
	
	print(\"珍稀增强幼龙：战斗开始时，使 \", 友方龙列表.size(), \" 个龙获得 +\", 加成值.x, \"/+\", 加成值.y)
"

[node name="珍稀增强幼龙" type="Node"]
